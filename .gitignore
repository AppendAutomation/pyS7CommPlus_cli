# ---- Python byte-compiled / optimized ----
__pycache__/
*.py[cod]
*$py.class

# ---- PyInstaller / build outputs ----
# The exe is a build artifact; rebuild with build.bat
build/
dist/
dist_linux/
*.spec.bak
*.manifest

# ---- Packaging / distribution ----
*.egg-info/
.eggs/
*.egg
wheels/
.Python

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Test / coverage / type-check caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets / local config (never commit to a public repo) ----
.env
.env.*
*.pem
*.key
secrets.*
*.local
